{
  "name": "tradingbot",
  "version": "1.0.0",
  "description": "TradingBot — Binance USDT-M 趋势跟踪交易框架，含单一策略智能模式、手动策略、GUI 与 headless",
  "default-features": ["gui"],
  "dependencies": [
    "simdjson",
    "curl",
    "mbedtls"
  ],
  "features": {
    "gui": {
      "description": "Qt Widgets 图形界面",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": ["widgets", "thread", "pcre2", "png"],
          "platform": "windows | osx"
        }
      ]
    }
  }
}
